[Unit]
Description=BME680 affichage e-ink (Waveshare 2.9inch, dernieres mesures)
After=network.target airmon-collector.service

[Service]
Type=simple
User=fabien
WorkingDirectory=/opt/airmon
ExecStart=/opt/airmon/venv/bin/python /opt/airmon/eink_display.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
